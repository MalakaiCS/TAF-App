# ── Secrets / local config ──────────────────────────────────────────────
# settings.json holds the Supabase key — commit settings.example.json instead.
settings.json
.claude/

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── PyInstaller / build output ──────────────────────────────────────────
build/
dist/
*.spec.bak
*.manifest

# ── Distributables / binaries ───────────────────────────────────────────
*.exe
dist.zip
data_entry_gui.exe
TAFOrderEntry_Setup.exe

# ── Runtime / user data ─────────────────────────────────────────────────
# Off Windows there is no APPDATA, so the app keeps these next to itself —
# which is the repo when it is run from source, or by the smoke test.
orders/
draft_order.json
catalog_cache.json
last_seen_version.txt
phone_inbox/
pending_sync/
backups/
invoices/

# ── Test / scratch artifacts ────────────────────────────────────────────
Test_TEST.xlsx
test_test.pdf
compare_test.pdf
Templates.pdf
# Scratch files live at the repo root only — anchored so they never match
# package files like taf_order_app/__init__.py.
/_*.png
/_*.py

# ── OS / editor ─────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
